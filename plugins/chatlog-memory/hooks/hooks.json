{
  "description": "Bind a governed Chatlog context session on fresh agent startup.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/scripts/session-start.js\"",
            "timeout": 10,
            "statusMessage": "Binding Chatlog context"
          }
        ]
      }
    ]
  }
}
