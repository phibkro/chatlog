#!/usr/bin/env sh
# Enable once per clone: git config core.hooksPath .githooks
# Formats, then gates. Skips gracefully where a tool is absent.
command -v oxfmt  >/dev/null 2>&1 && oxfmt . >/dev/null 2>&1 && git add -u
command -v oxlint >/dev/null 2>&1 && { oxlint || exit 1; }
command -v tsc    >/dev/null 2>&1 && { tsc --noEmit || exit 1; }
bash scripts/no-throw-ratchet.sh || exit 1
