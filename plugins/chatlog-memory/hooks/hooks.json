{
  "description": "Load the current Chatlog experience-memory index once for a new session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/scripts/session-start.js\"",
            "timeout": 10,
            "statusMessage": "Loading accepted Chatlog memory"
          }
        ]
      }
    ]
  }
}
